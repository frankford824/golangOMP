[Unit]
Description=Forward local OA API calls into the validation core namespace
Requires=yongbo-oa-core.service
After=yongbo-oa-core.service
JoinsNamespaceOf=yongbo-oa-core.service
PartOf=yongbo-oa-core.service
[Service]
PrivateNetwork=yes
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18086
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
