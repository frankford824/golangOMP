# Apply to MAIN only after migration and binary verification.
ASSET_MEDIA_JOBS_ENABLED=false
ASSET_MEDIA_ECS_WORKER_ENABLED=false
ASSET_MEDIA_STRICT_PREVIEWS=false
ASSET_MEDIA_QUARK_DISABLED=false
ASSET_MEDIA_NAS_SCAN_ENABLED=false
ASSET_MEDIA_NAS_WORKER_ENABLED=false
ASSET_MEDIA_NAS_DELIVERY_ENABLED=false
ASSET_MEDIA_EXTERNAL_ZIP_ENABLED=false
# Once v2 fingerprints are in production KEEP this enabled on executor rollback.
ASSET_MEDIA_VERSIONED_SOURCES_ENABLED=false
ASSET_MEDIA_GATEWAY_ID=company-nas
ASSET_MEDIA_GATEWAY_URL=https://media-cache.yongbo.cloud
ASSET_MEDIA_SIGNING_KEY_ID=media-v1
ASSET_MEDIA_SIGNING_KEY_FILE=/root/ecommerce_ai/shared/media-signing.key
ASSET_MEDIA_GATEWAY_TOKEN=
ASSET_MEDIA_WORKER_TOKEN=
# Scope is deliberately independent of index/watch scope:
EXTERNAL_ASSETS_OSS_REQUIRED_PREFIXES=/p3/仓库素材区/徐凯
EXTERNAL_ASSETS_SYNC_EXPORT_ROOTS=/p3/仓库素材区/徐凯
