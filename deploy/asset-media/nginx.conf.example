# Install only after DNS-01 certificate issuance and local DNS verification.
# No router WAN mapping. Do not log URI queries containing bearer tickets.
server {
    listen 443 ssl;
    server_name media-cache.yongbo.cloud;
    ssl_certificate /REPLACE_WITH_VERIFIED_CERTIFICATE/fullchain.pem;
    ssl_certificate_key /REPLACE_WITH_VERIFIED_CERTIFICATE/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/media-cache-error.log crit;
    location /edge/v1/ {
        proxy_pass http://127.0.0.1:18089;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 6h;
        proxy_send_timeout 6h;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
    location / { return 404; }
}
