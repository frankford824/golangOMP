[Unit]
Description=OA private order-data watchdog receiver
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=oa-dw-alerts
Group=yongbo-oa-live
EnvironmentFile=/etc/yongbo-oa-live/dw-alerts.env
ExecStart=/usr/bin/python3 -B /opt/yongbo-dw-alerts/receiver.py
StateDirectory=oa-dw-alerts
StateDirectoryMode=0700
RuntimeDirectory=oa-dw-alerts
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=100.64.0.0/10

[Install]
WantedBy=multi-user.target
