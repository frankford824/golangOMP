SERVER_PORT=8080
# Required. Do not leave a template root/password DSN in production.
MYSQL_DSN=__SET_REAL_MYSQL_DSN__
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# Required for production. Point to a real identity config with changed admin passwords.
AUTH_SETTINGS_FILE=/root/ecommerce_ai/shared/auth_identity.json
# Persistent user avatar storage. Keep this under shared/ so backend releases do not remove uploaded avatars.
USER_AVATAR_DIR=/root/ecommerce_ai/shared/avatars
# Keep false outside isolated local bootstrap/test runs.
AUTH_ALLOW_INSECURE_BOOTSTRAP_CREDENTIALS=false
# Required for /v1/agent/* machine endpoints. Agent clients send X-Agent-Token or Authorization: Bearer.
AGENT_API_TOKEN=__SET_REAL_AGENT_API_TOKEN__
# Optional comma-separated extra browser origins for WebSocket. Same host is allowed by default.
WS_ALLOWED_ORIGINS=
ERP_SYNC_ENABLED=true
ERP_SYNC_INTERVAL=5m
ERP_SYNC_SOURCE_MODE=stub
ERP_SYNC_STUB_FILE=config/erp_products_stub.json
ERP_SYNC_TIMEOUT=30s
ERP_BRIDGE_BASE_URL=http://127.0.0.1:8081
ERP_BRIDGE_TIMEOUT=15s
# ERP image sync short URL for OpenWeb Pic/PicBig fields, which are limited to 300 chars.
ERP_IMAGE_PROXY_PUBLIC_BASE_URL=https://yongbo.cloud
ERP_IMAGE_PROXY_TOKEN_TTL=8760h
# Optional. If empty, runtime falls back to existing internal/OSS/ERP secrets.
ERP_IMAGE_PROXY_SIGNING_SECRET=

# Warehouse auto-close: closes tasks after warehouse receipt and pushes final images to ERP.
ENABLE_CRON_WAREHOUSE_AUTO_RELEASE=false
CRON_SCHEDULE_WAREHOUSE_AUTO_RELEASE="*/5 * * * *"
WAREHOUSE_AUTO_RELEASE_LIMIT=100
WAREHOUSE_AUTO_RELEASE_GRACE_MINUTES=30
WAREHOUSE_AUTO_RELEASE_SYSTEM_ACTOR_ID=0

UPLOAD_SERVICE_ENABLED=true
UPLOAD_SERVICE_BASE_URL=http://100.111.214.38:8089
# Browser-facing multipart upload base.
# Recommended: "/" so MAIN returns same-origin "/upload/*" URLs.
# - deployed dist can call them directly through nginx
# - local Vite can proxy "/upload" in dev-server config
UPLOAD_SERVICE_BROWSER_MULTIPART_BASE_URL=/
# Optional browser-facing direct download base.
# Example: https://<bucket>.<region>.aliyuncs.com
# When set, MAIN builds browser-direct download_url from storage_key on this base.
UPLOAD_SERVICE_BROWSER_DOWNLOAD_BASE_URL=
UPLOAD_SERVICE_TIMEOUT=15s
UPLOAD_SERVICE_INTERNAL_TOKEN=
# Backward-compatible legacy alias. Prefer UPLOAD_SERVICE_INTERNAL_TOKEN.
UPLOAD_SERVICE_AUTH_TOKEN=
UPLOAD_STORAGE_PROVIDER=oss
EXTERNAL_ASSETS_ENABLED=false
EXTERNAL_ASSETS_BFF_BASE_URL=http://100.111.214.38:8080
EXTERNAL_ASSETS_BFF_BROWSER_BASE_URL=http://192.168.0.125:8080
EXTERNAL_ASSETS_ALIST_MOUNTS=/quark:netdisk,/p1:netdisk,/p2:netdisk,/p3:nas_local
EXTERNAL_ASSETS_SYNC_INTERVAL=1h
EXTERNAL_ASSETS_LINK_REFRESH_INTERVAL=1h
EXTERNAL_ASSETS_FULL_SYNC_ENABLED=false
EXTERNAL_ASSETS_FULL_SYNC_PAGE_SIZE=100
EXTERNAL_ASSETS_FULL_SYNC_MAX_DEPTH=16
EXTERNAL_ASSETS_FULL_SYNC_MAX_FILES_PER_MOUNT=20000
EXTERNAL_ASSETS_FULL_SYNC_MAX_DIRS_PER_MOUNT=5000
EXTERNAL_ASSETS_OSS_ORIGINAL_PREFIX=external-assets/alist/original
EXTERNAL_ASSETS_OSS_PREVIEW_PREFIX=external-assets/alist/preview
EXTERNAL_ASSETS_LOCAL_PATH_MAPPINGS=/p3=/volume1/image_lib
AI_AGENT_ENABLED=false
AI_AGENT_PROVIDER=anthropic_compatible
AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
AI_AGENT_MODEL=MiniMax-M3
AI_AGENT_TIMEOUT=90s
AI_AGENT_MAX_TOKENS=900

# Web Push delivery and SKU failure reconcile workers should be enabled on only
# one backend instance. The outbox claim token prevents duplicate push sends, but
# the reconcile scanner still does redundant work when multiple instances run it.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@yongbo.cloud
WEB_PUSH_WORKER_INTERVAL=10s
WEB_PUSH_WORKER_LIMIT=20
WEB_PUSH_LEASE_TTL=2m
WEB_PUSH_RETRY_BASE_DELAY=30s
WEB_PUSH_MAX_ATTEMPTS=5
SKU_SYNC_FAILURE_NOTIFICATION_SCAN_INTERVAL=5m
SKU_SYNC_FAILURE_NOTIFICATION_SCAN_LIMIT=50

# Experience learning half-loop. Keep all switches false until the empty
# backend, tables, UI, and observability have been deployed. Enable the
# experience worker on only one backend instance.
EXPERIENCE_UI_ENABLED=false
EXPERIENCE_CAPTURE_ENABLED=false
EXPERIENCE_AI_FEEDBACK_ENABLED=false
EXPERIENCE_BEHAVIOR_CAPTURE_ENABLED=false
EXPERIENCE_MICRO_QUESTION_ENABLED=false
EXPERIENCE_REVIEW_MATERIALIZATION_ENABLED=false
EXPERIENCE_BEHAVIOR_SAMPLE_RATE=0.2
EXPERIENCE_ENABLED_SURFACES=task_detail,asset_center,data_center
EXPERIENCE_WORKER_ENABLED=false
EXPERIENCE_WORKER_INTERVAL=15s
EXPERIENCE_WORKER_BATCH_SIZE=50
EXPERIENCE_WORKER_MAX_ATTEMPTS=5
EXPERIENCE_OUTBOX_LEASE_TTL=5m
EXPERIENCE_RUNTIME_CONFIG_FILE=
EXPERIENCE_RETENTION_DAYS=180

# Data-center business trend pilot. Leave empty for zero-cash internal-only validation.
BUSINESS_TREND_CHINA_HOT_URL=
APIFY_TOKEN=
BUSINESS_TREND_APIFY_BASE_URL=https://api.apify.com
BUSINESS_TREND_APIFY_DOUYIN_HOT_ACTOR=zen-studio/douyin-hot-search-scraper
BUSINESS_TREND_APIFY_DOUYIN_SEARCH_ACTOR=zen-studio/douyin-search-scraper
BUSINESS_TREND_APIFY_REDNOTE_SEARCH_ACTOR=zen-studio/rednote-search-scraper
BUSINESS_TREND_APIFY_1688_ACTOR=automation-lab/1688-scraper
BUSINESS_TREND_APIFY_TAOBAO_ACTOR=zen-studio/taobao-detail-scraper
BUSINESS_TREND_EXTERNAL_TIMEOUT=20s
BUSINESS_TREND_MAX_EXTERNAL_KEYWORDS=8
BUSINESS_TREND_MAX_EXTERNAL_ITEMS=24

# Enterprise WeChat intelligent robot long-connection push.
WECOM_AIBOT_ENABLED=false
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_DEFAULT_CHAT_ID=
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WECOM_AIBOT_QUEUE_SIZE=200
LOG_LEVEL=info
