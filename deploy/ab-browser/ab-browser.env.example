# Copy to a run-scoped file outside Git. Every value used by Compose is explicit;
# this stack never reads /root/ecommerce_ai/shared/main.env or another live env.
AB_COMPOSE_PROJECT=yb-v8-ab-r20260722a

AB_MYSQL_IMAGE=mysql@sha256:replace
AB_REDIS_IMAGE=redis@sha256:replace
AB_NGINX_IMAGE=nginx@sha256:replace
AB_PROBE_IMAGE=curlimages/curl@sha256:replace
AB_FIXTURE_IMAGE=python@sha256:replace
AB_EXTERNAL_BACKEND_IMAGE=local/external-backend@sha256:replace
AB_DEVPLUS_BACKEND_IMAGE=local/devplus-backend@sha256:replace
AB_EXTERNAL_BACKEND_SHA256=replace-with-64-hex-image-digest
AB_DEVPLUS_BACKEND_SHA256=replace-with-64-hex-image-digest

AB_MYSQL_ROOT_PASSWORD=replace-with-run-secret
AB_MYSQL_APP_USER=ab_app
AB_MYSQL_APP_PASSWORD=replace-with-run-secret
# A baseline backend is read-only. Create this account on the imported A_ui
# clone with SELECT-only grants; clone-ready-a verifies the effective grants.
AB_MYSQL_A_READONLY_USER=ab_a_reader
AB_MYSQL_A_READONLY_PASSWORD=replace-with-run-secret
AB_MYSQL_A_DATABASE=ab_r20260722a_a
AB_MYSQL_B_DATABASE=ab_r20260722a_b
AB_REDIS_PASSWORD=replace-with-run-secret

AB_AUTH_SETTINGS_A_FILE=/absolute/path/to/run/auth-a.json
AB_AUTH_SETTINGS_B_FILE=/absolute/path/to/run/auth-b.json
AB_AUTH_SETTINGS_SHA256=replace-with-identical-auth-file-sha256
AB_EXTERNAL_FRONT_DIR=/absolute/path/to/frozen-external-front
AB_DEVPLUS_FRONT_DIR=/absolute/path/to/frozen-devplus-front
AB_EXTERNAL_FRONTEND_SHA256=replace-with-validator-tree-sha256
AB_DEVPLUS_FRONTEND_SHA256=replace-with-validator-tree-sha256

# Backends cannot start until each restored UI clone has a validated receipt,
# a marker whose content is that receipt SHA-256, and the exact task count.
AB_A_UI_IMPORT_RECEIPT_FILE=/absolute/path/to/run/a-ui-import-receipt.json
AB_B_UI_IMPORT_RECEIPT_FILE=/absolute/path/to/run/b-ui-import-receipt.json
AB_A_UI_IMPORT_RECEIPT_SHA256=replace-with-a-receipt-sha256
AB_B_UI_IMPORT_RECEIPT_SHA256=replace-with-b-receipt-sha256
AB_A_UI_READY_MARKER_FILE=/absolute/path/to/run/a-ui-ready-marker.sha256
AB_B_UI_READY_MARKER_FILE=/absolute/path/to/run/b-ui-ready-marker.sha256
AB_A_UI_EXPECTED_TASK_COUNT=2347
AB_B_UI_EXPECTED_TASK_COUNT=2347

# Compose owns these fixtures; no fixture origin is a host or production URL.
# All roots and ports are distinct. Only the B upload root is writable.
AB_UPLOAD_A_ORIGIN=http://fixture-upload-a:18091
AB_UPLOAD_B_ORIGIN=http://fixture-upload-b:18092
AB_UPLOAD_A_PORT=18091
AB_UPLOAD_B_PORT=18092
AB_UPLOAD_A_IDENTITY=run-id:A_ui:upload
AB_UPLOAD_B_IDENTITY=run-id:B_ui:upload
AB_UPLOAD_A_ROOT=/absolute/path/to/run/fixture-upload-a
AB_UPLOAD_B_ROOT=/absolute/path/to/run/fixture-upload-b
AB_UPLOAD_A_SEED_ROOT=/absolute/path/to/run/frozen-upload-seed-a
AB_UPLOAD_B_SEED_ROOT=/absolute/path/to/run/frozen-upload-seed-b

# These origins are always read-only X-Accel byte sources.
AB_EXTERNAL_FILE_A_ORIGIN=http://fixture-object-a:18093
AB_EXTERNAL_FILE_B_ORIGIN=http://fixture-object-b:18094
AB_OBJECT_A_PORT=18093
AB_OBJECT_B_PORT=18094
AB_OBJECT_A_IDENTITY=run-id:A_ui:object
AB_OBJECT_B_IDENTITY=run-id:B_ui:object
AB_OBJECT_A_ROOT=/absolute/path/to/run/fixture-object-a
AB_OBJECT_B_ROOT=/absolute/path/to/run/fixture-object-b
AB_OBJECT_A_SEED_ROOT=/absolute/path/to/run/frozen-object-seed-a
AB_OBJECT_B_SEED_ROOT=/absolute/path/to/run/frozen-object-seed-b
AB_FIXTURE_SCRIPT_SHA256=replace-with-scripts-ab-ab-upload-fixture-sha256
AB_EXTERNAL_ASSETS_ENABLED=false

# Only these four ports are published, each on 127.0.0.1 by the Compose file.
AB_EDGE_EXTERNAL_EXTERNAL_PORT=18101
AB_EDGE_DEVPLUS_DEVPLUS_PORT=18102
AB_EDGE_EXTERNAL_DEVPLUS_PORT=18103
AB_EDGE_DEVPLUS_EXTERNAL_PORT=18104
