{
  "name": "design-workflow-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "build:test": "vue-tsc -b && vite build --mode test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api-types": "tsx scripts/gen_api_types.ts",
    "lint:object-key": "npx tsx scripts/check_object_key_usage.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.4.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.0.0"
  }
}
