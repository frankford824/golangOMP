{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "node_modules/.cache/vite-config-types",
    "tsBuildInfoFile": "node_modules/.cache/vite-config-types/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "vite.shared.ts"]
}
